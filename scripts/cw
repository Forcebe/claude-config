#!/usr/bin/env bash
set -euo pipefail

# The sidecar lives outside ~/.claude so Claude Code's own cleanup and backup
# routines never touch it. Overridable so the test suite can run in isolation.
workspace_root="${CLAUDE_WORKSPACE_ROOT:-$HOME/.claude-workspace}"

usage() {
	cat <<'EOF'
Usage: cw [--state | --sidecar | --repo | --key | --mode]
       cw status
       cw frontier|shape <run>
       cw claim|release|close <run> <slice>

Flags resolve paths and never write. Verbs act on the run graph.

  (no args)           Print the docs root: config, GLOSSARY.md and adr/
  --state             Print the run state root: run graph and claims. Inside
                      .git, so every worktree shares it and it is never committed
  --sidecar           Print the sidecar path, whether or not it is in use
  --repo              Print the main worktree root
  --key               Print the repository key
  --mode              Print "in-repo", "sidecar", or "unconfigured"

  status              Live worktrees, their branches, tmux sessions and claims
  frontier <run>      Slices that are open, unblocked and unclaimed
  shape <run>         "chain" if the blocking edges form one path, "fan-out" if
                      they branch or merge, "empty" if there are no slices
  claim <run> <s>     Take a slice. Fails if someone already holds it
  release <run> <s>   Give it back
  close <run> <s>     Mark it done, which also releases it

The storage mode is not recorded anywhere; it is implied by which config.md
exists. A repo holding .agents/workspace/config.md is in-repo. One whose sidecar
holds config.md is sidecar. Neither, and it is unconfigured, which resolves
as sidecar so that an unconfigured repo is never written into.

Run from inside any git repository.
EOF
	exit 1
}

# The first entry of `git worktree list` is always the main worktree, so this
# resolves to the same path whether we are called from the main checkout or
# from any of its worktrees.
main_dir=$(git worktree list --porcelain 2>/dev/null | head -1 | sed 's/^worktree //' || true)
if [[ -z "$main_dir" ]]; then
	echo "Error: not inside a git repository" >&2
	exit 1
fi

# origin is shared by every worktree, which is what makes the key stable.
# Reduce both scp-style and URL-style remotes to "<owner>--<repo>".
repo_key() {
	local url key=""
	url=$(git remote get-url origin 2>/dev/null || true)
	if [[ -n "$url" ]]; then
		key=$(printf '%s' "$url" |
			sed -e 's/\.git$//' -e 's#^[a-z+]*://##' -e 's/^[^@/]*@//' -e 's/:/\//' |
			awk -F/ '{ if (NF >= 2) printf "%s--%s", $(NF-1), $NF; else printf "%s", $NF }')
	fi
	if [[ -z "$key" ]]; then
		key=$(basename "$main_dir")
	fi
	printf '%s' "$key" | tr -c 'A-Za-z0-9._-' '-'
}

key=$(repo_key)
sidecar="$workspace_root/$key"
# Tracked docs belong to the branch being worked on, so this is the current
# worktree rather than the main checkout.
tree_docs="$(git rev-parse --show-toplevel)/.agents/workspace"
state="$(cd "$(git rev-parse --git-common-dir)" && pwd -P)/agent-workspace"

# A sidecar config wins over a repo one. The repo is the surface we must never
# write to by accident, so ambiguity resolves away from it.
mode() {
	if [[ -f "$sidecar/config.md" ]]; then
		printf 'sidecar'
	elif [[ -f "$tree_docs/config.md" ]]; then
		printf 'in-repo'
	else
		printf 'unconfigured'
	fi
}

docs_root() {
	case "$(mode)" in
	in-repo) printf '%s\n' "$tree_docs" ;;
	*) printf '%s\n' "$sidecar" ;;
	esac
}

# --- run graph -------------------------------------------------------------

# These set globals rather than printing, because a helper called as $(...)
# runs in a subshell where `exit` ends only the substitution: the caller would
# carry on with an empty value and fail later, confusingly.
run_dir=""
slice_md=""

valid_id() {
	[[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] || {
		echo "Error: invalid slice id '$1'" >&2
		exit 1
	}
}

require_run() {
	run_dir="$state/runs/$1"
	[[ -d "$run_dir" ]] || {
		echo "Error: no run '$1' under $state/runs" >&2
		exit 1
	}
}

require_slice() {
	valid_id "$1"
	slice_md="$run_dir/slices/$1.md"
	[[ -f "$slice_md" ]] || {
		echo "Error: no slice '$1' in $run_dir/slices" >&2
		exit 1
	}
}

# Only the first --- fenced block is the header. Prose in the body that starts
# with a key is prose, and must neither be read nor rewritten.
slice_field() {
	awk -v key="$2:" '
		NR == 1 && $0 == "---" { inhdr = 1; next }
		inhdr && $0 == "---"   { exit }
		inhdr && index($0, key) == 1 {
			sub(/^[^:]*:[[:space:]]*/, "")
			print
			exit
		}
	' "$1"
}

set_status_done() {
	awk '
		NR == 1 && $0 == "---" { inhdr = 1; print; next }
		inhdr && $0 == "---"   { inhdr = 0; print; next }
		inhdr && /^status:/    { print "status: done"; next }
		{ print }
	' "$1" >"$1.tmp" && mv "$1.tmp" "$1"
}

slice_ids() {
	[[ -d "$1/slices" ]] || return 0
	find "$1/slices" -maxdepth 1 -name '*.md' | sort | while read -r f; do
		basename "$f" .md
	done
}

claim_holder() {
	[[ -f "$1/claims/$2/holder" ]] && cat "$1/claims/$2/holder" || true
}

is_claimed() { [[ -d "$1/claims/$2" ]]; }

is_blocked() {
	local dir="$1" id="$2" blocker
	for blocker in $(slice_field "$dir/slices/$id.md" blocked-by); do
		[[ -f "$dir/slices/$blocker.md" ]] || continue
		[[ "$(slice_field "$dir/slices/$blocker.md" status)" == "done" ]] || return 0
	done
	return 1
}

cmd_frontier() {
	local id
	require_run "$1"
	for id in $(slice_ids "$run_dir"); do
		[[ "$(slice_field "$run_dir/slices/$id.md" status)" == "open" ]] || continue
		is_blocked "$run_dir" "$id" && continue
		is_claimed "$run_dir" "$id" && continue
		printf '%s\n' "$id"
	done
}

# A chain is a single path: one start, and nothing ever branching or merging.
# Anything else fans out. The distinction decides whether a run's tickets can
# become a stack of pull requests or have to share an integration branch.
cmd_shape() {
	local id other blocker blockers roots=0 maxblockers=0 maxdeps=0 n
	require_run "$1"
	if [[ -z "$(slice_ids "$run_dir")" ]]; then
		printf 'empty\n'
		return
	fi
	for id in $(slice_ids "$run_dir"); do
		blockers=$(slice_field "$run_dir/slices/$id.md" blocked-by)
		n=$(printf '%s' "$blockers" | wc -w | tr -d ' ')
		if [[ "$n" -eq 0 ]]; then roots=$((roots + 1)); fi
		if [[ "$n" -gt "$maxblockers" ]]; then maxblockers=$n; fi

		n=0
		for other in $(slice_ids "$run_dir"); do
			for blocker in $(slice_field "$run_dir/slices/$other.md" blocked-by); do
				if [[ "$blocker" == "$id" ]]; then n=$((n + 1)); fi
			done
		done
		if [[ "$n" -gt "$maxdeps" ]]; then maxdeps=$n; fi
	done

	if [[ "$roots" -eq 1 && "$maxblockers" -le 1 && "$maxdeps" -le 1 ]]; then
		printf 'chain\n'
	else
		printf 'fan-out\n'
	fi
}

# mkdir is the lock: it is atomic on every filesystem we care about, so the
# first of two concurrent worktrees wins and the loser sees a plain failure.
cmd_claim() {
	local tree session
	require_run "$1"
	require_slice "$2"
	mkdir -p "$run_dir/claims"
	if ! mkdir "$run_dir/claims/$2" 2>/dev/null; then
		echo "Error: '$2' is already claimed by:" >&2
		claim_holder "$run_dir" "$2" | sed 's/^/  /' >&2
		exit 1
	fi
	tree=$(git rev-parse --show-toplevel)
	session=$(basename "$tree" | tr ".,: " "____")
	cat >"$run_dir/claims/$2/holder" <<EOF
branch: $(git rev-parse --abbrev-ref HEAD)
worktree: $tree
session: $session
at: $(date -u +%Y-%m-%dT%H:%M:%SZ)
EOF
	printf '%s\n' "$2"
}

# A claim can outlive its ticket, so this only needs the id to be safe.
cmd_release() {
	require_run "$1"
	valid_id "$2"
	rm -rf "${run_dir:?}/claims/${2:?}"
}

cmd_close() {
	require_run "$1"
	require_slice "$2"
	set_status_done "$slice_md"
	rm -rf "${run_dir:?}/claims/${2:?}"
}

# Everything here is derived live, so a killed session or a removed worktree
# disappears from the output without anything needing to be cleaned up.
live_worktrees() {
	git worktree list --porcelain | awk '
		/^worktree /  { wt = substr($0, 10); dead = 0 }
		/^prunable/   { dead = 1 }
		/^$/          { if (wt != "" && !dead) print wt; wt = "" }
		END           { if (wt != "" && !dead) print wt }
	'
}

cmd_status() {
	local tree branch session claims
	printf '%-38s %-46s %-9s %s\n' WORKTREE BRANCH SESSION CLAIMS
	live_worktrees | while read -r tree; do
		[[ -d "$tree" ]] || continue
		branch=$(git -C "$tree" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')
		session=$(basename "$tree" | tr ".,: " "____")
		if tmux has-session -t "$session" 2>/dev/null; then session=live; else session=-; fi
		claims=$(claims_for "$tree")
		printf '%-38s %-46s %-9s %s\n' "$(basename "$tree")" "$branch" "$session" "${claims:--}"
	done
}

claims_for() {
	local tree="$1" holder out=""
	[[ -d "$state/runs" ]] || return 0
	while IFS= read -r holder; do
		grep -qxF "worktree: $tree" "$holder" || continue
		out+="$(basename "$(dirname "$(dirname "$(dirname "$holder")")")")/$(basename "$(dirname "$holder")") "
	done < <(find "$state/runs" -name holder -type f 2>/dev/null)
	printf '%s' "${out% }"
}

case "${1:-}" in
"") docs_root ;;
--state) printf '%s\n' "$state" ;;
--sidecar) printf '%s\n' "$sidecar" ;;
--repo) printf '%s\n' "$main_dir" ;;
--key) printf '%s\n' "$key" ;;
--mode) mode && echo ;;
status) cmd_status ;;
frontier) [[ $# -eq 2 ]] || usage; cmd_frontier "$2" ;;
shape) [[ $# -eq 2 ]] || usage; cmd_shape "$2" ;;
claim) [[ $# -eq 3 ]] || usage; cmd_claim "$2" "$3" ;;
release) [[ $# -eq 3 ]] || usage; cmd_release "$2" "$3" ;;
close) [[ $# -eq 3 ]] || usage; cmd_close "$2" "$3" ;;
-h | --help) usage ;;
*)
	echo "Error: unknown option '$1'" >&2
	usage
	;;
esac
